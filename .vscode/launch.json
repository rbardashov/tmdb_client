  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dart: Attach to Process",
      "type": "dart",
      "request": "attach"
    },
    {
      "name": "debug",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main_dev.dart",
      "args": ["--flavor", "dev", "--dart-define-from-file", "secret_DEBUG.json"]
    },
    {
      "name": "release_debug",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main_prod.dart",
      "args": ["--flavor", "prod", "--dart-define-from-file", "secret_PROD.json"]
    },
    {
      "name": "release_profile",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main_prod.dart",
      "args": ["--flavor", "prod", "--dart-define-from-file", "secret_PROD.json"]
    },
  ]
}